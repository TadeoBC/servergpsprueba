# ─────────────────────────────────────────────────────────────────────────────
# atlyx-gps — variables de entorno
# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
# El archivo .env NUNCA se sube a git (ver .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# Usuario/contraseña/nombre de la base. docker-compose los usa para inicializar
# el contenedor de PostGIS Y para armar la cadena de conexión del servicio node.
POSTGRES_USER=atlyx
POSTGRES_PASSWORD=cambia-esta-password-larga-y-aleatoria
POSTGRES_DB=atlyx_gps

# Host del postgres. Dentro de docker-compose es el nombre del servicio (db).
# Si corres node fuera de docker apuntando al postgres del compose: localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cadena completa. Si la defines, tiene prioridad sobre las variables de arriba.
# DATABASE_URL=postgres://atlyx:password@db:5432/atlyx_gps

# Tamaño máximo del pool de conexiones de node hacia postgres.
PG_POOL_MAX=10

# ── Ingesta TCP (rastreadores) ───────────────────────────────────────────────
# Puerto donde escuchan los equipos. Debe coincidir con el comando SMS:
#   SERVER,1,gps.atlyx.online,5023,0#
TCP_PORT=5023
TCP_HOST=0.0.0.0

# Timeout de socket inactivo, en milisegundos (5 min). Al vencer se cierra
# la conexión y se libera el buffer acumulador de ese socket.
TCP_SOCKET_TIMEOUT_MS=300000

# Rate limit por IP de origen:
#   MAX_CONN_PER_IP        conexiones simultáneas permitidas desde una misma IP
#   CONN_RATE_PER_IP       conexiones nuevas permitidas por ventana
#   CONN_RATE_WINDOW_MS    tamaño de la ventana del rate limit
# Un equipo real usa 1 conexión. Valores altos solo sirven para pruebas.
MAX_CONN_PER_IP=20
CONN_RATE_PER_IP=60
CONN_RATE_WINDOW_MS=60000

# Bytes máximos que se acumulan en el buffer de un socket antes de considerarlo
# basura y cerrarlo. Protege contra un cliente que manda datos sin delimitador.
TCP_MAX_BUFFER_BYTES=65536

# ── Servidor web / API ───────────────────────────────────────────────────────
# Puerto interno de Express. Caddy hace reverse proxy a este puerto.
# NO se publica directo a internet en producción (solo Caddy lo alcanza).
HTTP_PORT=8080

# Origen público de la interfaz. Se usa para armar enlaces y para CORS.
PUBLIC_URL=https://view.atlyx.online

# ── Autenticación de la interfaz web ─────────────────────────────────────────
# Usuario del panel.
AUTH_USER=admin

# Contraseña. Genera el hash con:  npm run hash-password -- 'tu-password'
# y pega el resultado en AUTH_PASSWORD_HASH. Formato: scrypt$<salt>$<hash>
AUTH_PASSWORD_HASH=

# Alternativa SOLO para desarrollo local: contraseña en texto plano.
# Si AUTH_PASSWORD_HASH está vacío se usa esta y el servidor loguea un WARN.
AUTH_PASSWORD=cambiame

# Secreto para firmar la cookie de sesión (HMAC). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si lo cambias, todas las sesiones abiertas se invalidan.
SESSION_SECRET=

# Duración de la sesión en horas.
SESSION_HOURS=168

# Marca la cookie de sesión como Secure (solo viaja por HTTPS).
# En producción detrás de Caddy: true. En local por http://localhost: false.
COOKIE_SECURE=true

# ── Presentación ─────────────────────────────────────────────────────────────
# Todo se GUARDA en UTC. Esta zona solo afecta cómo se MUESTRA en la interfaz.
DISPLAY_TIMEZONE=America/Mexico_City

# Umbrales del semáforo de estado del equipo, en minutos.
STATUS_GREEN_MINUTES=5
STATUS_AMBER_MINUTES=30

# Ajuste visual de la estela a calles mediante OSRM. Si el servicio no responde,
# la interfaz usa automáticamente la traza GPS filtrada. Para uso intensivo,
# despliega tu propio OSRM y cambia MAP_MATCH_URL.
MAP_MATCH_ENABLED=true
MAP_MATCH_URL=https://router.project-osrm.org
MAP_MATCH_TIMEOUT_MS=8000
MAP_MATCH_MAX_POINTS=400

# ── Logs ─────────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info

# true = salida legible para humanos (desarrollo). false = JSON (producción).
LOG_PRETTY=false

# Guarda el hex crudo de CADA paquete en positions.raw_hex / events.raw.
# Déjalo en true: es la red de seguridad para re-decodificar histórico.
STORE_RAW_HEX=true

# ── Despliegue / doctor ──────────────────────────────────────────────────────
# IP pública del VPS. La usa `npm run doctor` para verificar que los registros
# DNS apuntan a donde deben y que el 5023 se alcanza desde internet.
VPS_PUBLIC_IP=34.174.220.57

# Dominio de ingesta TCP. En Cloudflare va con la NUBE GRIS (proxy DESACTIVADO).
GPS_DOMAIN=gps.atlyx.online

# Dominio de la interfaz web. En Cloudflare va con la NUBE NARANJA (proxy ON).
VIEW_DOMAIN=view.atlyx.online

# Correo para el certificado TLS automático de Caddy (Let's Encrypt).
ACME_EMAIL=tu-correo@ejemplo.com

# ── Simulador (npm run simulate) ─────────────────────────────────────────────
# Contra qué host/puerto se conecta el rastreador falso.
SIM_HOST=127.0.0.1
SIM_PORT=5023

# IMEI que reporta el simulador. Por defecto el del equipo real, para que la
# interfaz se vea igual que en producción. Cámbialo si quieres un equipo aparte.
SIM_IMEI=351840620204473

# Segundos entre posiciones simuladas.
SIM_INTERVAL_SECONDS=5
